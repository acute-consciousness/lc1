{
  "expo": {
    "name": "localcyclic",
    "slug": "localcyclic-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localcyclic.localcyclicv2"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.localcyclic.localcyclicv2",
      "permissions": ["READ_MEDIA_IMAGES"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "520c5cd1-445a-4576-9f11-e80b31be854e"
      }
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
          [
        "expo-image-picker",
        {
          "photosPermission": "The app needs permission to select item photos."
        }
      ]
      
    ]

  }
}
